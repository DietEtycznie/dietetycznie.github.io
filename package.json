{
  "name": "diet-medical-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed-firestore.mjs",
    "backup": "node scripts/seed-firestore.mjs --backup"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "firebase": "^13.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.31",
    "@angular/cli": "^21.2.31",
    "@angular/compiler-cli": "^21.2.26",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
